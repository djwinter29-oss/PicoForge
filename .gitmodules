[submodule "firmware/third_party/FreeRTOS-Kernel"]
	path = firmware/third_party/FreeRTOS-Kernel
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel.git
[submodule "firmware/third_party/pico-sdk"]
	path = firmware/third_party/pico-sdk
	url = https://github.com/raspberrypi/pico-sdk.git
[submodule "firmware/third_party/embedded-cli"]
	path = firmware/third_party/embedded-cli
	url = https://github.com/funbiscuit/embedded-cli.git
[submodule "firmware/third_party/levelx"]
	path = firmware/third_party/levelx
	url = https://github.com/eclipse-threadx/levelx.git
