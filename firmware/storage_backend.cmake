set(PF_STORAGE_BACKEND "SD" CACHE STRING "Application filesystem and MSC backend: SD or NOR")
set_property(CACHE PF_STORAGE_BACKEND PROPERTY STRINGS SD NOR)
if(NOT PF_STORAGE_BACKEND MATCHES "^(SD|NOR)$")
    message(FATAL_ERROR "PF_STORAGE_BACKEND must be SD or NOR")
endif()
set(PF_NOR_REGION_OFFSET "" CACHE STRING "Explicit external LevelX region offset in bytes")
set(PF_NOR_REGION_SIZE "" CACHE STRING "Explicit external LevelX region size in bytes")
if(PF_STORAGE_BACKEND STREQUAL "NOR")
    foreach(region_value PF_NOR_REGION_OFFSET PF_NOR_REGION_SIZE)
        if(NOT "${${region_value}}" MATCHES "^(0[xX][0-9a-fA-F]+|[0-9]+)$")
            message(FATAL_ERROR "NOR requires explicit numeric PF_NOR_REGION_OFFSET and PF_NOR_REGION_SIZE")
        endif()
    endforeach()
    math(EXPR pf_nor_offset "${PF_NOR_REGION_OFFSET}")
    math(EXPR pf_nor_size "${PF_NOR_REGION_SIZE}")
    if(pf_nor_offset LESS 0 OR pf_nor_offset GREATER 16777216 OR
       pf_nor_size LESS 49152 OR pf_nor_size GREATER 16777216)
        message(FATAL_ERROR "NOR FatFs region must be at least 48 KiB and fit within external W25Q128")
    endif()
    math(EXPR pf_nor_alignment "(${pf_nor_offset} | ${pf_nor_size}) & 4095")
    math(EXPR pf_nor_end "${pf_nor_offset} + ${pf_nor_size}")
    if(pf_nor_alignment OR pf_nor_end GREATER 16777216)
        message(FATAL_ERROR "NOR FatFs region must be 4 KiB aligned, at least 48 KiB, within external W25Q128")
    endif()
    if(NOT PF_SD_CARD_PORT STREQUAL "FREERTOS")
        message(FATAL_ERROR "The NOR filesystem/MSC application requires PF_SD_CARD_PORT=FREERTOS")
    endif()
endif()
