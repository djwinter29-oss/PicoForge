.define public SDIO_CLK_PIN_D0_OFFSET 30

.program picoforge_sdio_clock
.side_set 1
.wrap_target
    nop side 0
    nop side 1
.wrap

.program picoforge_sdio_command
.side_set 1
.wrap_target
wait_for_command:
    mov y, !STATUS side 0
    jmp !y wait_for_command side 1
    pull block side 0
    set pins, 1 side 1
    set pindirs, 1 side 0
    set x, 31 side 1
send_command_first_word:
    out pins, 1 side 0
    jmp x-- send_command_first_word side 1
    set x, 15 side 0
send_command_last_word:
    out pins, 1 side 1
    jmp x-- send_command_last_word side 0
    set pindirs, 0 side 1
    pull block side 0
    out y, 8 side 1
    jmp !y command_complete side 0
wait_for_response:
    nop side 1
    jmp pin wait_for_response side 0
read_response:
    in pins, 1 side 1
    jmp y-- read_response side 0
    push block side 1
command_complete:
    irq set 0 side 0
.wrap

.program picoforge_sdio_data_rx
    pull block
    out y, 32
    wait 0 pin 0
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
    mov x, y
receive_nibble:
    wait 0 pin SDIO_CLK_PIN_D0_OFFSET
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
    in pins, 4
    jmp x-- receive_nibble
    irq set 1

.program picoforge_sdio_data_tx
    pull block
    out x, 32
    set pindirs, 15
    set pins, 0
    wait 0 pin SDIO_CLK_PIN_D0_OFFSET
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
transmit_nibble:
    wait 0 pin SDIO_CLK_PIN_D0_OFFSET
    out pins, 4
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
    jmp x-- transmit_nibble
    set pins, 15
    wait 0 pin SDIO_CLK_PIN_D0_OFFSET
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
    set pindirs, 0
    wait 0 pin 0
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
    set x, 3
read_data_response:
    wait 0 pin SDIO_CLK_PIN_D0_OFFSET
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
    in pins, 1
    jmp x-- read_data_response
    push block
    wait 1 pin 0
    irq set 2