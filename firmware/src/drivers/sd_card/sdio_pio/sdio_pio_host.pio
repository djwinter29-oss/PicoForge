.define public SDIO_CLK_PIN_D0_OFFSET 30

.program pf_sdio_pio_clock
.side_set 1
.wrap_target
    nop side 0
    nop side 1
.wrap

.program pf_sdio_pio_command
.side_set 1
.wrap_target
wait_for_command:
    mov y, !STATUS side 0
    jmp !y wait_for_command side 1
    pull block side 0
    set pins, 1 side 1
    set pindirs, 1 side 0
    set x, 31 side 1
send_command_first_word:
    out pins, 1 side 0
    jmp x-- send_command_first_word side 1
    set x, 15 side 1
send_command_last_word:
    out pins, 1 side 0
    jmp x-- send_command_last_word side 1
    set pindirs, 0 side 0
    pull block side 1
    out y, 8 side 0
    jmp !y command_complete side 1
wait_for_response:
    nop side 0
    jmp pin wait_for_response side 1
read_response:
    in pins, 1 side 0
    jmp y-- read_response side 1
    push block side 0
command_complete:
    irq set 0 side 1
.wrap

.program pf_sdio_pio_data_rx
    pull block
receive_block:
    mov x, osr
    wait 0 pin 0
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
receive_nibble:
    wait 0 pin SDIO_CLK_PIN_D0_OFFSET
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
    in pins, 4
    jmp x-- receive_nibble
    wait 1 pin 0
    jmp y-- receive_block
    irq set 1

.program pf_sdio_pio_data_tx
    pull block
    out x, 32
    set pins, 15
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
    wait 0 pin SDIO_CLK_PIN_D0_OFFSET
    set pindirs, 15
    set pins, 0
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
transmit_nibble:
    wait 0 pin SDIO_CLK_PIN_D0_OFFSET
    out pins, 4
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
    jmp x-- transmit_nibble
    wait 0 pin SDIO_CLK_PIN_D0_OFFSET
    set pins, 15
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
    wait 0 pin SDIO_CLK_PIN_D0_OFFSET
    set pindirs, 0
    wait 0 pin 0
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
    set x, 3
read_data_response:
    wait 0 pin SDIO_CLK_PIN_D0_OFFSET
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
    in pins, 1
    jmp x-- read_data_response
    push block
    wait 0 pin SDIO_CLK_PIN_D0_OFFSET
    wait 1 pin SDIO_CLK_PIN_D0_OFFSET
    wait 1 pin 0
    irq set 2